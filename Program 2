#include <stdio.h>

long long power(int x, int n) {
    long long result = 1;

    while (n > 0) {
        if (n % 2 == 1)
            result *= x;

        x *= x;
        n /= 2;
    }

    return result;
}

int main() {
    int x = 2, n = 5;
    long long sum;

    if (x == 1)
        sum = n + 1;
    else
        sum = (power(x, n + 1) - 1) / (x - 1);

    printf("Sum of series = %lld", sum);

    return 0;
}
