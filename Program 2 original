#include <stdio.h>

int main() {
    int a[] = {7, 10, 4, 3, 20, 15};
    int n = 6, k = 3;

    for (int i = 0; i < n - 1; i++) {
        int min = i;

        for (int j = i + 1; j < n; j++) {
            if (a[j] < a[min])
                min = j;
        }

        int temp = a[i];
        a[i] = a[min];
        a[min] = temp;
    }

    printf("The %dth smallest element is %d", k, a[k - 1]);

    return 0;
}
